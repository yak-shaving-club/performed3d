# Create an app at https://www.strava.com/settings/api and set its
# Authorization Callback Domain to localhost (for local development).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must match the origin used to open the app.
PORT=8000
APP_ORIGIN=http://localhost:8000
# Set COOKIE_SECURE=true when serving over HTTPS.
COOKIE_SECURE=false
